#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APP  ICON "minSolo.ico"
IDI_TRAY ICON "tray.ico"

1 RT_MANIFEST "minSolo.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MINSOLO_VERSION_MAJOR,MINSOLO_VERSION_MINOR,MINSOLO_VERSION_PATCH,0
 PRODUCTVERSION MINSOLO_VERSION_MAJOR,MINSOLO_VERSION_MINOR,MINSOLO_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "cbkow"
            VALUE "FileDescription",  "minSolo - per-app mute and solo"
            VALUE "FileVersion",      MINSOLO_VERSION_STR
            VALUE "InternalName",     "minSolo"
            VALUE "LegalCopyright",   "Copyright (c) 2026 cbkow. MIT License."
            VALUE "OriginalFilename", "minSolo.exe"
            VALUE "ProductName",      "minSolo"
            VALUE "ProductVersion",   MINSOLO_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
